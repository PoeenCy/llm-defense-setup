# 10 — Malicious upload / webshell. ALERT ONLY.
alert http any any -> any any (msg:"LIB UPLOAD executable script extension in multipart filename (.php .phtml .phar .jsp .py .sh .cgi)"; flow:to_server,established; http.request_body; pcre:"/filename=\x22[^\x22]*\.(php\d?|phtml|phar|pht|jsp|jspx|aspx?|py|sh|cgi|pl|htaccess)(\.[a-z]{0,4})?\x22/i"; classtype:web-application-attack; sid:9210001; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB UPLOAD double extension / null byte filename (shell.php.jpg, shell.php%00.png)"; flow:to_server,established; http.request_body; pcre:"/filename=\x22[^\x22]*\.(php|phtml|jsp|py)(%00|\x00|\.)[^\x22]*\x22/i"; classtype:web-application-attack; sid:9210002; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB UPLOAD traversal in multipart filename (../)"; flow:to_server,established; http.request_body; pcre:"/filename=\x22[^\x22]*(\.\.\/|\.\.\\)/i"; classtype:web-application-attack; sid:9210003; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB WEBSHELL PHP code in request body (<?php / <?= with system|eval|passthru)"; flow:to_server,established; http.request_body; pcre:"/<\?(php|=).{0,200}(system|eval|exec|passthru|shell_exec|assert|popen|base64_decode|\$_(GET|POST|REQUEST|COOKIE))/is"; classtype:web-application-attack; sid:9210004; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB WEBSHELL command parameter to script (cmd= / exec= / c= on .php/.jsp)"; flow:to_server,established; http.uri; pcre:"/\.(php\d?|phtml|jsp|aspx?|cgi)\?(cmd|exec|command|c|shell|run)=/i"; classtype:web-application-attack; sid:9210005; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB UPLOAD .htaccess / web.config overwrite"; flow:to_server,established; http.request_body; pcre:"/filename=\x22[^\x22]*(\.htaccess|web\.config|\.user\.ini)\x22/i"; classtype:web-application-attack; sid:9210006; rev:1; priority:1;)
