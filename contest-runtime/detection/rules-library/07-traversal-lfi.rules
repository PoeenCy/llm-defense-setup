# 07 — Path traversal / Local File Inclusion. ALERT ONLY.
alert http any any -> any any (msg:"LIB LFI ../ traversal (2+ levels) in uri"; flow:to_server,established; http.uri.raw; pcre:"/(\.\.|%2e%2e|%252e%252e|\.%2e|%2e\.)(\/|\\|%2f|%5c|%252f)(\.\.|%2e%2e|%252e%252e|\.%2e|%2e\.)(\/|\\|%2f|%5c|%252f)/i"; classtype:web-application-attack; sid:9207001; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB LFI ../ traversal in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/\.\.[\/\\]\.\.[\/\\]|\.\.[\/\\][\w.-]+\.(php|py|db|sqlite|json|ya?ml|conf|txt|log|key|pem)/i"; classtype:web-application-attack; sid:9207002; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB LFI sensitive file name (/etc/passwd, /proc/self, .ssh, flag files)"; flow:to_server,established; http.request_line; url_decode; pcre:"/\/etc\/(passwd|shadow|hosts|group)|\/proc\/(self|\d+)\/(environ|cmdline|cwd|fd|maps|root)|\.ssh\/(id_|authorized_keys)|\/flag(s)?(\.txt)?\b|\/app\/(app|main|server)\.py|\.\.\/\.env/i"; classtype:web-application-attack; sid:9207003; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB LFI sensitive file name in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/\/etc\/(passwd|shadow|hosts|group)|\/proc\/(self|\d+)\/(environ|cmdline|cwd|fd|maps|root)|\.ssh\/(id_|authorized_keys)|\/flag(s)?(\.txt)?\b|\.\.\/\.env/i"; classtype:web-application-attack; sid:9207004; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB LFI null byte / double-encoding trick (%00 / %252e)"; flow:to_server,established; http.uri.raw; pcre:"/%00|%2500|%252e|%252f|%c0%ae|%c0%af|%e0%80%ae/i"; classtype:web-application-attack; sid:9207005; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB LFI absolute path in file parameter (file=/... path=/... page=/...)"; flow:to_server,established; http.request_line; url_decode; pcre:"/[?&](file|path|page|filename|template|include|doc|document|folder|dir|load|read|download|img|image)=\s*(\/|[a-z]:\\)/i"; classtype:web-application-attack; sid:9207006; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB LFI /etc/passwd content in RESPONSE (traversal worked)"; flow:to_client,established; http.response_body; content:"root:x:0:0:"; classtype:web-application-attack; sid:9207007; rev:1; priority:1;)
