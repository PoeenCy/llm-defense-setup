# 12 — XSS & misc web. ALERT ONLY. (XSS rarely scores in A/D, but admin-bot services exist.)
alert http any any -> any any (msg:"LIB XSS <script> / javascript: / on*= handler"; flow:to_server,established; http.request_line; url_decode; pcre:"/<script[\s>]|javascript\s*:|<[a-z]+[^>]*\son(error|load|mouseover|focus|toggle)\s*=|<svg[^>]*onload/i"; classtype:web-application-attack; sid:9212001; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB XSS in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/<script[\s>]|javascript\s*:|<[a-z]+[^>]*\son(error|load|mouseover|focus|toggle)\s*=|<svg[^>]*onload/i"; classtype:web-application-attack; sid:9212002; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB HEADER injection CRLF in uri (%0d%0a)"; flow:to_server,established; http.uri.raw; pcre:"/%0d%0a|%0a%0d|%0d|%0a/i"; classtype:web-application-attack; sid:9212003; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB AUTH bypass header (X-Original-URL / X-Rewrite-URL / X-Forwarded-For: 127.0.0.1)"; flow:to_server,established; http.header; pcre:"/X-(Original|Rewrite)-URL\s*:|X-(Forwarded-For|Real-IP|Client-IP|Remote-Addr)\s*:\s*(127\.0\.0\.1|localhost|0\.0\.0\.0)/i"; classtype:web-application-attack; sid:9212004; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB LDAP injection (*)(| / )(uid=*)"; flow:to_server,established; http.request_line; url_decode; pcre:"/\*\)\s*\(\s*[|&]|\)\s*\(\s*\w+\s*=\s*\*/"; classtype:web-application-attack; sid:9212005; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB login brute force — 20 POSTs to a login path in 10s from one source"; flow:to_server,established; http.method; content:"POST"; http.uri; pcre:"/login|signin|auth|token/i"; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-user; sid:9212006; rev:1; priority:3;)
