# 06 — GraphQL abuse. ALERT ONLY.
# Introspection via __schema is the most common in-the-wild GraphQL attack (Imperva); also batching, deep nesting, field suggestion probing.
alert http any any -> any any (msg:"LIB GRAPHQL introspection query (__schema)"; flow:to_server,established; http.request_line; url_decode; content:"__schema"; nocase; classtype:attempted-recon; sid:9206001; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB GRAPHQL introspection query in body (__schema)"; flow:to_server,established; http.request_body; content:"__schema"; nocase; classtype:attempted-recon; sid:9206002; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB GRAPHQL type probing (__type / __typename on Query root)"; flow:to_server,established; http.request_body; pcre:"/__type\s*\(\s*name\s*:/i"; classtype:attempted-recon; sid:9206003; rev:1; priority:3;)
alert http any any -> any any (msg:"LIB GRAPHQL batched query array (brute force / rate-limit bypass)"; flow:to_server,established; http.request_body; pcre:"/^\s*\[\s*\{\s*\x22(query|operationName)\x22/"; classtype:web-application-attack; sid:9206004; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB GRAPHQL many aliases in one query (alias brute force) — 10+ alias: patterns"; flow:to_server,established; http.request_body; pcre:"/(\w+\s*:\s*\w+\s*\([^)]*\)[^:]*){10,}/s"; classtype:web-application-attack; sid:9206005; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB GRAPHQL deep nesting (10+ levels of {) — DoS / data walk"; flow:to_server,established; http.request_body; pcre:"/(\{[^{}]*){10,}/"; classtype:web-application-attack; sid:9206006; rev:1; priority:3;)
alert http any any -> any any (msg:"LIB GRAPHQL injection inside argument (SQLi/NoSQLi in GraphQL variables)"; flow:to_server,established; http.request_body; content:"query"; nocase; pcre:"/(['\x22]\s*(or|and)\s+['\x22\d]|union\s+select|\\\\?\x22\$(ne|gt|regex|where)\\\\?\x22)/i"; classtype:web-application-attack; sid:9206007; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB GRAPHQL mutation from unexpected client — review (very common, tune or disable)"; flow:to_server,established; http.request_body; pcre:"/\x22query\x22\s*:\s*\x22\s*mutation\b/i"; classtype:web-application-activity; sid:9206008; rev:1; priority:4;)
