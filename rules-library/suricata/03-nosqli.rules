# 03 — NoSQL (MongoDB-style) injection. ALERT ONLY.
# Shapes: param[$ne]=x  /  {"user":{"$ne":null}}  /  $where JS  /  $regex brute force. $ may arrive as %24.
alert http any any -> any any (msg:"LIB NOSQLI operator in query/form param (param[$ne]= ...)"; flow:to_server,established; http.request_line; url_decode; pcre:"/\[\s*\$(ne|eq|gt|gte|lt|lte|in|nin|regex|where|exists|or|and|not|nor|expr|function)\s*\]/i"; classtype:web-application-attack; sid:9203001; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB NOSQLI operator in form body (param[$ne]= ...)"; flow:to_server,established; http.request_body; url_decode; pcre:"/\[\s*\$(ne|eq|gt|gte|lt|lte|in|nin|regex|where|exists|or|and|not|nor|expr|function)\s*\]/i"; classtype:web-application-attack; sid:9203002; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB NOSQLI operator object in JSON body ({\"$ne\": ...})"; flow:to_server,established; http.request_body; pcre:"/\x22\$(ne|eq|gt|gte|lt|lte|in|nin|regex|where|exists|or|and|not|nor|expr|function|elemMatch|lookup)\x22\s*:/i"; classtype:web-application-attack; sid:9203003; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB NOSQLI $where / server-side JS (this.password, sleep(), function())"; flow:to_server,established; http.request_body; url_decode; pcre:"/\$where|this\.\w+\s*(==|\.match|\[)|function\s*\(\s*\)\s*\{|\bsleep\s*\(\s*\d{3,}/i"; classtype:web-application-attack; sid:9203004; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB NOSQLI $regex brute force (^a.* style prefix guessing)"; flow:to_server,established; http.request_line; url_decode; pcre:"/\$regex\]?\x22?\s*[=:]\s*\x22?\^/i"; classtype:web-application-attack; sid:9203005; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB NOSQLI JS injection in string (', return true, var x=' / '||'1'=='1)"; flow:to_server,established; http.request_body; url_decode; pcre:"/['\x22]\s*(\|\||&&|\x3b)\s*(return\s+true|['\x22]?\w+['\x22]?\s*==)/i"; classtype:web-application-attack; sid:9203006; rev:1; priority:2;)
