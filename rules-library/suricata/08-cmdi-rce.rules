# 08 — OS command injection / RCE / webshell use. ALERT ONLY.
alert http any any -> any any (msg:"LIB CMDI shell metachar + command (, | && ` $( followed by id/cat/ls/sh/nc/curl/wget/python...)"; flow:to_server,established; http.request_line; url_decode; pcre:"/(\x3b|\||&&|`|\$\(|\n)\s*(id|whoami|uname|cat|ls|pwd|sh|bash|nc|ncat|curl|wget|python3?|perl|php|ruby|busybox|echo|env|printenv|find|head|tail|base64)\b/i"; classtype:web-application-attack; sid:9208001; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB CMDI shell metachar + command in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/(\x3b|\||&&|`|\$\(|\n)\s*(id|whoami|uname|cat|ls|pwd|sh|bash|nc|ncat|curl|wget|python3?|perl|php|ruby|busybox|env|printenv|find|base64)\b/i"; classtype:web-application-attack; sid:9208002; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB CMDI ${IFS} / brace expansion evasion"; flow:to_server,established; http.request_line; url_decode; pcre:"/\$\{IFS\}|\$IFS\$\d|\{(cat|ls|id),/i"; classtype:web-application-attack; sid:9208003; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB RCE reverse shell payload (bash -i >& /dev/tcp, nc -e, mkfifo, socket.socket)"; flow:to_server,established; http.request_line; url_decode; pcre:"/\/dev\/tcp\/|nc\s+(-\w+\s+)*-e\s|mkfifo\s|socket\.socket\s*\(|pty\.spawn|sh\s+-i\b/i"; classtype:trojan-activity; sid:9208004; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB RCE reverse shell payload in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/\/dev\/tcp\/|nc\s+(-\w+\s+)*-e\s|mkfifo\s|socket\.socket\s*\(|pty\.spawn|sh\s+-i\b/i"; classtype:trojan-activity; sid:9208005; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB RCE code-eval function in input (eval( / exec( / system( / os.popen / subprocess / __import__)"; flow:to_server,established; http.request_body; url_decode; pcre:"/\b(eval|exec|system|passthru|shell_exec|popen|proc_open|assert)\s*\(|os\.(popen|system)|subprocess\.|__import__\s*\(/i"; classtype:web-application-attack; sid:9208006; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB RCE uid= output in RESPONSE (command ran)"; flow:to_client,established; http.response_body; pcre:"/uid=\d+\([a-z_][\w-]*\)\s+gid=\d+/"; classtype:successful-admin; sid:9208007; rev:1; priority:1;)
alert tcp any any -> any any (msg:"LIB POST-EXPLOIT interactive shell prompt over plain TCP (sh/bash prompt leaving a host)"; flow:established; content:"sh-"; pcre:"/(^|\n)(sh|bash)-\d\.\d[#$] $/"; classtype:trojan-activity; sid:9208008; rev:1; priority:1;)
