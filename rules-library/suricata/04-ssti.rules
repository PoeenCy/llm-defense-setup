# 04 — Server-Side Template Injection. ALERT ONLY.
# Patterns: OWASP CRS 934200/934180 (delimiters containing ( * or __) + engine-specific gadgets (Jinja2/Twig/Mako/ERB/Freemarker/Velocity/EJS).
alert http any any -> any any (msg:"LIB SSTI {{ ... ( or __ ... }} expression (uri)"; flow:to_server,established; http.uri; pcre:"/\{\{[^}]*?([\(\*]|__)[^}]*?\}\}/"; classtype:web-application-attack; sid:9204001; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI {{ ... ( or __ ... }} expression (body)"; flow:to_server,established; http.request_body; url_decode; pcre:"/\{\{[^}]*?([\(\*]|__)[^}]*?\}\}/"; classtype:web-application-attack; sid:9204002; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI math probe {{7*7}} / ${7*7} / #{7*7} / <%= 7*7 %>"; flow:to_server,established; http.request_line; url_decode; pcre:"/(\{\{|\$\{|#\{|<%=?)\s*\d+\s*\*\s*\d+\s*(\}\}|\}|%>)/"; classtype:web-application-attack; sid:9204003; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI math probe in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/(\{\{|\$\{|#\{|<%=?)\s*\d+\s*\*\s*\d+\s*(\}\}|\}|%>)/"; classtype:web-application-attack; sid:9204004; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI Python/Jinja2 gadget (__class__ / __mro__ / __subclasses__ / __globals__ / __builtins__ / lipsum / cycler)"; flow:to_server,established; http.request_line; url_decode; pcre:"/__(class|mro|subclasses|globals|builtins|init|import)__|\b(lipsum|cycler|joiner|namespace)\s*\.\s*__|config\.items\s*\(|request\.application|self\._TemplateReference__context|\|attr\s*\(/i"; classtype:web-application-attack; sid:9204005; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI Python/Jinja2 gadget in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/__(class|mro|subclasses|globals|builtins|init|import)__|\b(lipsum|cycler|joiner|namespace)\s*\.\s*__|config\.items\s*\(|request\.application|self\._TemplateReference__context|\|attr\s*\(/i"; classtype:web-application-attack; sid:9204006; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI block tag {% ... %} / ERB <% ... %> (uri+body)"; flow:to_server,established; http.request_body; url_decode; pcre:"/\{%[^%}]*%\}|<%=?[^%>]*%>/"; classtype:web-application-attack; sid:9204007; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SSTI Java/EL/Freemarker/Velocity gadget (freemarker.template / #set / getRuntime / T(java.lang"; flow:to_server,established; http.request_body; url_decode; pcre:"/freemarker\.template|\?new\s*\(|#set\s*\(|\$class\.inspect|getRuntime\s*\(|T\s*\(\s*java\.lang|ProcessBuilder|ScriptEngineManager/i"; classtype:web-application-attack; sid:9204008; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI Node (EJS/Pug/Handlebars) gadget (process.mainModule / constructor.constructor / child_process)"; flow:to_server,established; http.request_body; url_decode; pcre:"/process\.mainModule|constructor\s*\.\s*constructor|constructor\s*\(\s*['\x22]return|child_process|outputFunctionName|escapeFunction/i"; classtype:web-application-attack; sid:9204009; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SSTI evaluated 49 / 7777777 in RESPONSE after probe (template executed)"; flow:to_client,established; http.response_body; content:"7777777"; classtype:web-application-attack; sid:9204010; rev:1; priority:2;)
