# 02 — SQL injection. ALERT ONLY.
# Patterns follow OWASP CRS 942xxx (paranoia 1-2) and sqlmap payload shapes.
# http.uri is already percent-decoded by Suricata; bodies are url_decode'd here.
alert http any any -> any any (msg:"LIB SQLI UNION SELECT (uri)"; flow:to_server,established; http.uri; pcre:"/union(\s|\/\*.*?\*\/|\+|%20)+(all(\s|\+)+)?select/i"; classtype:web-application-attack; sid:9202001; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI UNION SELECT (body)"; flow:to_server,established; http.request_body; url_decode; pcre:"/union(\s|\/\*.*?\*\/|\+)+(all(\s|\+)+)?select/i"; classtype:web-application-attack; sid:9202002; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI tautology quote OR 1=1 / 'a'='a' (uri)"; flow:to_server,established; http.uri; pcre:"/['\x22`]\s*\)?\s*(or|and|\|\||&&)\s*\(?\s*(['\x22`]?\w*['\x22`]?\s*(=|like|<>|!=)\s*['\x22`]?\w*|\d+\s*(=|>|<)\s*\d+|true|1)/i"; classtype:web-application-attack; sid:9202003; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI tautology quote OR 1=1 / 'a'='a' (body)"; flow:to_server,established; http.request_body; url_decode; pcre:"/['\x22`]\s*\)?\s*(or|and|\|\||&&)\s*\(?\s*(['\x22`]?\w*['\x22`]?\s*(=|like|<>|!=)\s*['\x22`]?\w*|\d+\s*(=|>|<)\s*\d+|true|1)/i"; classtype:web-application-attack; sid:9202004; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI quote followed by comment (admin'-- / '#)"; flow:to_server,established; http.request_line; url_decode; pcre:"/['\x22`]\s*(--|#|\/\*)/"; classtype:web-application-attack; sid:9202005; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SQLI quote followed by comment in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/['\x22`]\s*\)*\s*(--[\s+]|#|\/\*)/"; classtype:web-application-attack; sid:9202006; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SQLI time-based (sleep/benchmark/pg_sleep/waitfor delay)"; flow:to_server,established; http.request_line; url_decode; pcre:"/(sleep\s*\(\s*\d|benchmark\s*\(|pg_sleep\s*\(|waitfor\s+delay|randomblob\s*\()/i"; classtype:web-application-attack; sid:9202007; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI time-based in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/(sleep\s*\(\s*\d|benchmark\s*\(|pg_sleep\s*\(|waitfor\s+delay|randomblob\s*\()/i"; classtype:web-application-attack; sid:9202008; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI schema enumeration (information_schema / sqlite_master / pg_catalog / sysobjects)"; flow:to_server,established; http.request_line; url_decode; pcre:"/information_schema|sqlite_master|sqlite_schema|pg_catalog|pg_tables|sysobjects|mysql\.user/i"; classtype:web-application-attack; sid:9202009; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI schema enumeration in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/information_schema|sqlite_master|sqlite_schema|pg_catalog|pg_tables|sysobjects|mysql\.user/i"; classtype:web-application-attack; sid:9202010; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI stacked query / file ops (, drop|insert|update ... / load_file / into outfile / copy ... program)"; flow:to_server,established; http.request_line; url_decode; pcre:"/(\x3b\s*(drop|insert|update|delete|create|alter|exec|declare)\s|load_file\s*\(|into\s+(out|dump)file|copy\s+\w+\s+(from|to)\s+program)/i"; classtype:web-application-attack; sid:9202011; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI stacked query / file ops in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/(\x3b\s*(drop|insert|update|delete|create|alter|exec|declare)\s|load_file\s*\(|into\s+(out|dump)file|copy\s+\w+\s+(from|to)\s+program)/i"; classtype:web-application-attack; sid:9202012; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI error/boolean probing functions (extractvalue/updatexml/group_concat/substr(...,1,1))"; flow:to_server,established; http.request_line; url_decode; pcre:"/(extractvalue\s*\(|updatexml\s*\(|group_concat\s*\(|string_agg\s*\(|(substr|substring|mid)\s*\(.{1,60},\s*\d+\s*,\s*1\s*\)|char\s*\(\s*\d+\s*,)/i"; classtype:web-application-attack; sid:9202013; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SQLI error/boolean probing functions in body"; flow:to_server,established; http.request_body; url_decode; pcre:"/(extractvalue\s*\(|updatexml\s*\(|group_concat\s*\(|string_agg\s*\(|(substr|substring|mid)\s*\(.{1,60},\s*\d+\s*,\s*1\s*\)|char\s*\(\s*\d+\s*,)/i"; classtype:web-application-attack; sid:9202014; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SQLI in cookie"; flow:to_server,established; http.cookie; url_decode; pcre:"/(union\s+select|['\x22]\s*(or|and)\s+['\x22\d]|sleep\s*\(\s*\d|information_schema)/i"; classtype:web-application-attack; sid:9202015; rev:1; priority:1;)
alert http any any -> any any (msg:"LIB SQLI database error in RESPONSE (injection probably worked)"; flow:to_client,established; http.response_body; pcre:"/(You have an error in your SQL syntax|SQLSTATE\[|sqlite3\.OperationalError|SQLite3::|unterminated quoted string|pg_query\(\)|psycopg2\.errors|ORA-\d{5}|Microsoft OLE DB|syntax error at or near)/i"; classtype:web-application-attack; sid:9202016; rev:1; priority:1;)
