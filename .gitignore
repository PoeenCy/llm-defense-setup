# offline-bundle/ is a regenerable build artifact (run pull-and-save.sh to
# recreate it): cloned repos (Tulip, ctf_proxy, pcap-broker), ~16GB of docker
# image tarballs, python wheels, and Ollama model blobs. None of it is source.
offline-bundle/

# Auto-generated by generators/*.py from services.json — regenerate with
# bringup.sh, don't hand-edit or commit.
offline-bundle/repos/tulip/.env
offline-bundle/repos/ctf_proxy/proxy/config/config.json

# Runtime data: captured test traffic, Suricata's own generated config/logs
# (suricata.yaml, classification.config, etc. are copied in by the container
# at startup — only lib/rules/suricata.rules is a real source file).
traffic/*.pcap
suricata/log/
suricata/etc/
suricata/lib/*
!suricata/lib/rules/
suricata/lib/rules/*
!suricata/lib/rules/suricata.rules

# User's own RAG documents for AnythingLLM — personal/competition-specific
vault/*
!vault/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo

# Misc
*.log
.DS_Store
