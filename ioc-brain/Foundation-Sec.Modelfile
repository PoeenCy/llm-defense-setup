# Foundation-Sec-8B-GGUF (Mungert quant) ships with no chat template metadata
# (TEMPLATE defaults to {{ .Prompt }}), so Ollama never applies the system/user
# role markers and the model free-runs instead of following instructions.
# Foundation-Sec-8B is Llama-3.1-8B based, so we wrap it with the standard
# Llama-3 chat template to restore instruction-following.
FROM hf.co/Mungert/Foundation-Sec-8B-GGUF:Q4_K_M
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ range .Messages }}{{ if eq .Role "user" }}<|start_header_id|>user<|end_header_id|>

{{ .Content }}<|eot_id|>{{ else if eq .Role "assistant" }}<|start_header_id|>assistant<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}{{ end }}<|start_header_id|>assistant<|end_header_id|>

"""
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
