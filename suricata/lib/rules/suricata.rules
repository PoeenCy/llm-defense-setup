# Minimal starter ruleset for the CTF Monitor Hub.
# Replace/extend with a real ruleset (e.g. Emerging Threats Open:
# https://rules.emergingthreats.net/open/suricata-7.0.3/emerging-all.rules)
# before competition day — this file only has test/example rules.

alert tcp any any -> any any (msg:"CTF-TEST Possible flag exfil pattern"; content:"flag="; nocase; sid:1000002; rev:1;)
# added 2026-10-11T07:19:03 from rule library (01-scanners-recon.rules)
alert http any any -> any any (msg:"LIB SCAN sqlmap user-agent"; flow:to_server,established; http.user_agent; content:"sqlmap"; nocase; classtype:attempted-recon; sid:9201001; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN nikto user-agent"; flow:to_server,established; http.user_agent; content:"nikto"; nocase; classtype:attempted-recon; sid:9201002; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN nuclei user-agent"; flow:to_server,established; http.user_agent; content:"nuclei"; nocase; classtype:attempted-recon; sid:9201003; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN dir brute-forcer user-agent (gobuster/dirbuster/feroxbuster/ffuf/wfuzz)"; flow:to_server,established; http.user_agent; pcre:"/gobuster|dirbuster|feroxbuster|fuzz faster|wfuzz|dirsearch/i"; classtype:attempted-recon; sid:9201004; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN injection tool user-agent (commix/tplmap/SSTImap/ghauri/havij/jSQL/xsstrike)"; flow:to_server,established; http.user_agent; pcre:"/commix|tplmap|sstimap|ghauri|havij|jsql|xsstrike|xsser|sqlninja|TInjA/i"; classtype:attempted-recon; sid:9201005; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN generic scanner user-agent (nmap/masscan/zgrab/whatweb/wpscan/acunetix/nessus/openvas)"; flow:to_server,established; http.user_agent; pcre:"/nmap|masscan|zgrab|whatweb|wpscan|acunetix|nessus|openvas|netsparker|w3af|arachni|skipfish|wapiti|zmeu/i"; classtype:attempted-recon; sid:9201006; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN GraphQL scanner user-agent (graphw00f/graphql-cop)"; flow:to_server,established; http.user_agent; pcre:"/graphw00f|graphql-cop/i"; classtype:attempted-recon; sid:9201007; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB SCAN fake/broken browser user-agent (Mozlila / Mozilla/5.g / Mozilla/6.0)"; flow:to_server,established; http.user_agent; pcre:"/Mozlila|Mozilla\/5\.g|Mozilla\/6\.0/"; classtype:attempted-recon; sid:9201008; rev:1; priority:3;)
alert http any any -> any any (msg:"LIB SCAN empty user-agent"; flow:to_server,established; http.header_names; content:!"User-Agent"; nocase; classtype:attempted-recon; sid:9201009; rev:1; priority:3;)
alert http any any -> any any (msg:"LIB RECON request for .git / .svn / .hg"; flow:to_server,established; http.uri; pcre:"/\/\.(git|svn|hg)(\/|$)/i"; classtype:attempted-recon; sid:9201010; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB RECON request for .env / config / backup file"; flow:to_server,established; http.uri; pcre:"/\/(\.env|\.DS_Store|config\.(php|json|yml|yaml)\.?(bak|old|swp|~)?|[^\/]*\.(bak|old|orig|swp|sql|tar|tar\.gz|tgz|zip|7z|rar))(\?|$)/i"; classtype:attempted-recon; sid:9201011; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB RECON request for admin/debug endpoint (phpinfo/server-status/actuator/console/debug)"; flow:to_server,established; http.uri; pcre:"/\/(phpinfo(\.php)?|server-status|server-info|actuator(\/|$)|console(\/|$)|debug(\/|$)|_profiler|__debug__|adminer\.php|phpmyadmin)/i"; classtype:attempted-recon; sid:9201012; rev:1; priority:3;)
alert http any any -> any any (msg:"LIB RECON nmap HTTP probe path"; flow:to_server,established; http.uri; pcre:"/\/(nice%20ports|nice ports|Trinity\.txt\.bak|evox\/about|HNAP1)/i"; classtype:attempted-recon; sid:9201013; rev:1; priority:2;)
alert http any any -> any any (msg:"LIB RECON unusual HTTP method (TRACE/TRACK/PROPFIND/DEBUG/CONNECT)"; flow:to_server,established; http.method; pcre:"/^(TRACE|TRACK|PROPFIND|DEBUG|CONNECT|SEARCH)$/"; classtype:attempted-recon; sid:9201014; rev:1; priority:3;)
alert http any any -> any any (msg:"LIB SCAN burst of 404s from one source (dir brute force) — 20 in 10s"; flow:to_client,established; http.stat_code; content:"404"; threshold:type both, track by_dst, count 20, seconds 10; classtype:attempted-recon; sid:9201015; rev:1; priority:2;)
alert tcp any any -> any any (msg:"LIB SCAN many new connections from one source (port/service sweep) — 60 SYN in 10s"; flags:S,12; flow:stateless; threshold:type both, track by_src, count 60, seconds 10; classtype:network-scan; sid:9201016; rev:1; priority:3;)
